<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- NOTE: this file is meant to be merged into a project scaffolded with
		     `dotnet new maui -n RouteWeatherPlanner` on a machine with the MAUI
		     workload installed (see README.md). It is not a build-verified
		     project on its own; Platforms/, Resources/, AndroidManifest.xml,
		     Info.plist etc. come from the template and aren't reproduced here. -->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>RouteWeatherPlanner</RootNamespace>
		<UseMaui>true</UseMaui>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Renamed from "Route Weather Planner" to "Weatherline" — this is the
		     on-device label shown under the app icon. Doesn't affect ApplicationId,
		     namespaces, or any file/folder names in this project (those stay
		     RouteWeatherPlanner throughout; renaming them would be a much bigger,
		     purely-cosmetic refactor with no functional benefit). The Play Store
		     listing name and AdMob app name are separate settings in their respective
		     consoles, not controlled by this project — update those there too if you
		     want "Weatherline" to be consistent everywhere. -->
		<ApplicationTitle>Weatherline</ApplicationTitle>
		<!-- Second rename: com.fivestringcode.weatherroute (the never-personal-account
		     replacement for com.routeweatherplanner.app — see README.md's publishing
		     notes for that whole story) came back as already in use when registering
		     in Play Console. Switched to com.fivestringcode.weatherline to match the
		     app's actual display name ("Weatherline") instead of trying another
		     variant of the old name. -->
		<ApplicationId>com.fivestringcode.weatherline</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<!-- Play Console rejects a bundle whose version code was already uploaded
		     ("Version code 1 has already been used") - every upload to any track
		     needs a strictly higher integer than all previous ones. Bump this before
		     each new .aab you build for upload. -->
		<ApplicationVersion>4</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- 26.0, already well above the 23.0 floor Plugin.AdMob's setup docs call out
		     as the Google Play Services minimum — no change needed for the AdMob swap. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Explicit as of .NET 8: UseMaui=true no longer pulls this in implicitly
		     (see MA002). -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />

		<!-- builder.Logging.AddDebug() in MauiProgram.cs needs this: same package
		     proximityalarm references for the same reason. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.*" />

		<!-- HTTP resilience: routing/weather calls will hit 429/timeout on weak signal.
		     proximityalarm doesn't need this (no third-party HTTP calls to retry) but
		     this app's whole value prop depends on those calls succeeding on a drive. -->
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.*" />

		<!-- Banner ad, second attempt: Anjo.Android.AppLovin (a raw .NET-for-Android
		     binding of AppLovin MAX's native SDK) is gone — see README item 14 for the
		     full story of why (AppLovin sign-up went several days with no SDK key, plus
		     three real build-time fights: a version conflict, a binding-interface-name
		     mismatch, and a duplicate-class dexing error). Plugin.AdMob replaces it: a
		     free/open-source, actively maintained .NET MAUI-first package (not a raw
		     native binding) with a ready-to-use <BannerAd> XAML control, built for
		     net10.0. See Configuration/AdMobConfig.cs, MauiProgram.cs, and
		     Views/RoutePlanningPage.xaml for the rest of the integration. Note: the
		     duplicate-class dexing error turned out NOT to be AppLovin-specific after
		     all — see the Compose.Runtime.Annotation.Jvm PackageReference below, which
		     had to be reintroduced when the exact same error resurfaced under
		     Plugin.AdMob alone. -->
		<PackageReference Include="Plugin.AdMob" Version="3.0.2" />

		<!-- Real build error hit on the AdMob-only build (Plugin.AdMob, no AppLovin
		     anywhere in the graph): the D8 dexer failed with "Type
		     androidx.compose.runtime.Immutable is defined multiple times", from two
		     NuGet packages that both ship the same Compose runtime annotation class -
		     Xamarin.AndroidX.Compose.Runtime.Annotation.Android and
		     ...Annotation.Jvm, both resolving to 1.10.0.1. This is the identical error
		     (same packages, same version) that showed up during the AppLovin era and
		     was fixed the same way there - which means the original fix comment was
		     wrong to describe it as AppLovin-specific. It's really coming from
		     somewhere in Plugin.AdMob's own Google Play Services / Google Mobile Ads
		     dependency chain (Xamarin.GooglePlayServices.Ads.Lite and/or
		     Xamarin.Google.UserMessagingPlatform, both Android dependencies of
		     Plugin.AdMob per its NuGet listing), not anything AppLovin ever
		     contributed. This app doesn't use Jetpack Compose directly; excluding the
		     Jvm variant's assets stops it from contributing its duplicate classes.jar
		     to the dex merge while still satisfying whatever in the graph declared a
		     dependency on it. -->
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1"
		                   Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
		                   ExcludeAssets="all" />
	</ItemGroup>

</Project>
